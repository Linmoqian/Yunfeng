{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认能力",
  "windows": ["main"],
  "permissions": [
    "allow-paper-asset-action",
    "allow-paper-export-pdf",
    "allow-terminal-action",
    "allow-collaboration-action",
    "desktop-services",
    "allow-component-read",
    "allow-component-patch",
    "allow-component-window",
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
