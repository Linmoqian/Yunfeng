{
	"name": "yunfeng-cli",
	"version": "0.0.0",
	"private": true,
	"description": "Yunfeng coding agent CLI monorepo",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "npm run build --workspace=@yunfeng/tui && npm run build --workspace=@yunfeng/cli",
		"test": "npm run build --workspace=@yunfeng/tui && npm run test --workspace=@yunfeng/tui && npm run test --workspace=@yunfeng/cli",
		"clean": "npm run clean --workspaces --if-present",
		"demo": "tsx packages/tui/demo/cli.ts",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"smoke": "tsx packages/tui/demo/smoke.ts",
		"cli": "tsx packages/cli/src/index.ts"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.6",
		"tsx": "^4.23.12",
		"typescript-eslint": "^8.67.0"
	}
}
