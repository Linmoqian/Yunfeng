# Node 服务端读取；真实 .env 已被 Git 忽略。宿主同名变量优先。
YUNFENG_MODEL_PROVIDER=zai
YUNFENG_MODEL_ID=glm-5.3-flash
ZAI_API_KEY=replace-with-your-api-key

# 科研节点相关性（可选）：完整 Embedding 端点；不自动复用聊天模型或凭据。
# 显式配置后将节点目标文本发送到该端点，按节点变化缓存。
# YUNFENG_EMBEDDING_URL=https://embedding.example.com/v1/embeddings
# YUNFENG_EMBEDDING_MODEL=your-embedding-model
# YUNFENG_EMBEDDING_API_KEY=replace-with-your-api-key
